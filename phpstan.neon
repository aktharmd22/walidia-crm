includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 6

    # Larastan types a belongsTo as non-null because the relation method says
    # so, which turns every defensive `?->` on an optional relation into a
    # false positive. The defensive code is right; the inference is optimistic.
    treatPhpDocTypesAsCertain: false

    excludePaths:
        - app/Actions/Fortify/*

    ignoreErrors:
        # Larastan types every belongsTo as non-null, so a defensive `?->` on
        # an optional relation reads as redundant. The relation really can be
        # null — a booking without a marina, a cost sheet without a booking —
        # so the code stays defensive and the inference is ignored.
        - identifier: nullsafe.neverNull
        # The shared CRUD base dispatches on `class-string<TModel>`. PHPStan
        # cannot see SoftDeletes or model scopes through a template parameter;
        # the concrete controllers are checked normally.
        -
            path: app/Http/Controllers/ResourceController.php
            identifier: staticMethod.notFound
        -
            path: app/Http/Controllers/ResourceController.php
            identifier: method.notFound
        -
            identifier: missingType.generics
            path: app/Http/Controllers/ResourceController.php
        -
            identifier: return.type
            path: app/Http/Controllers/ResourceController.php
